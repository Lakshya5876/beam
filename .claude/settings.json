{
  "permissions": {
    "defaultMode": "default",
    "allow": [
      "Bash(grep:*)",
      "Bash(find:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git update-index:*)",
      "Bash(npm test:*)",
      "Bash(npm run test:*)",
      "Bash(npx vitest:*)",
      "Bash(npm run lint:*)",
      "Bash(npx eslint:*)",
      "Bash(npm run typecheck:*)",
      "Bash(npx tsc:*)",
      "Bash(npm run build:*)",
      "Read(*)",
      "Edit(*)",
      "Write(*)"
    ],
    "deny": [
      "Bash(git reset --hard*)",
      "Bash(git rebase*)",
      "Bash(git clean*)",
      "Bash(rm -rf*)",
      "Bash(sudo*)",
      "Bash(DROP *)",
      "Bash(TRUNCATE *)",
      "Bash(DELETE FROM *)",
      "Bash(nc *)",
      "Bash(ssh *)",
      "Bash(scp *)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push --force-with-lease*)",
      "Bash(git push --mirror*)",
      "Bash(git push --delete*)",
      "Bash(git commit --no-verify*)",
      "Bash(git commit -n *)",
      "Bash(git push --no-verify*)",
      "Bash(git -c core.hooksPath*)",
      "Bash(SKIP_COVENANT=*)",
      "Read(.env)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.pem)",
      "Read(**/id_rsa*)",
      "Read(**/.aws/credentials)",
      "Bash(cat .env*)",
      "Bash(cat **/.env*)",
      "Bash(cat **/*.pem*)",
      "Bash(cat **/id_rsa*)",
      "Bash(cat **/.aws/credentials*)",
      "Write(.githooks/**)",
      "Edit(.githooks/**)",
      "Write(.claude/hooks/**)",
      "Edit(.claude/hooks/**)",
      "Write(.claude/covenant_integrity.sha256)",
      "Edit(.claude/covenant_integrity.sha256)",
      "Write(.claude/covenant_state.json)",
      "Edit(.claude/covenant_state.json)",
      "Write(.github/workflows/covenant.yml)",
      "Edit(.github/workflows/covenant.yml)",
      "Bash(git notes*remove*)",
      "Bash(git update-ref -d*)",
      "Bash(git config core.hooksPath*)",
      "Bash(git config --add core.hooksPath*)",
      "Bash(git commit -a*)",
      "Bash(git commit -am*)",
      "Bash(git commit --amend*)",
      "Write(v1_claude_code_development_guide_existing.md)",
      "Edit(v1_claude_code_development_guide_existing.md)",
      "Write(v1_implementation_package_existing.md)",
      "Edit(v1_implementation_package_existing.md)",
      "Write(.claude/settings.json)",
      "Edit(.claude/settings.json)",
      "Write(CLAUDE.md)",
      "Edit(CLAUDE.md)",
      "Write(.claude/baseline.json)",
      "Edit(.claude/baseline.json)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$(git rev-parse --show-toplevel 2>/dev/null || pwd)\" && bash .claude/hooks/pre_bash_trust_root_guard.sh"
          }
        ]
      }
    ]
  }
}
