# Beam — environment template. Placeholder keys ONLY; real values are
# injected at shell level and NEVER written to disk.
# All env access goes through src/config.ts — never process.env in feature code.
BEAM_LOG_LEVEL=info
APP_PORT=8080

# --- Host CLI (all optional) -------------------------------------------------
# Endpoints. Unset = the compiled-in defaults; a CLI flag beats both.
# BEAM_SIGNALING_URL=wss://your-deployment.pages.dev
# BEAM_VIEWER_URL=https://your-deployment.pages.dev

# Extra ICE servers for the HOST peer, comma-separated
# (stun:host:port, turn:user:pass@host:port). NORMALLY UNNECESSARY: the host
# fetches ICE servers — including server-minted TURN credentials — from the
# signaling origin's /ice-config, and merges them with anything set here.
# Use this only to pin a self-hosted STUN/coturn. TURN credentials set here
# live ONLY in the shell env and are never written to disk.
# BEAM_ICE_SERVERS=stun:stun.l.google.com:19302

# 'relay' forces the connection through TURN, suppressing direct candidates.
# VERIFICATION/DIAGNOSIS ONLY — it proves the relay path works, or shows that
# a network needs it. Normal sessions leave this unset so ICE prefers a direct
# pair and relays only as a fallback. The viewer's equivalent is ?relay=1.
# BEAM_ICE_TRANSPORT_POLICY=relay

# libdatachannel log level (Verbose|Debug|Info|Warning|Error). Deep-diagnosis
# knob for when --debug is not enough.
# BEAM_NATIVE_LOG=Info

# --- Signaling / viewer Worker (set via wrangler, NOT this file) --------------
# TURN is configured on the DEPLOYMENT, not the CLI, so credentials are minted
# server-side and never shipped to a client. See signaling/wrangler.jsonc.
#   METERED_APP_NAME    var    — the <app> in https://<app>.metered.live
#   METERED_SECRET_KEY  SECRET — npx wrangler secret put METERED_SECRET_KEY
#   TURN_TTL_SECONDS    var    — minted credential lifetime (default 14400)
# NEVER commit METERED_SECRET_KEY, and never place it in a wrangler.jsonc
# "vars" block — that file is committed.
