{
  "name": "beam-viewer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Beam viewer — browser bootstrap + service worker. Isolated package (own lockfile/bundler) that imports the CORE shared protocol read-only.",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "build": "vite build && npm run build:worker",
    "build:worker": "npx esbuild _worker-src/entry.ts --bundle --format=esm --platform=neutral --target=es2022 --outfile=dist/_worker.js"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "4.1.8",
    "typescript": "6.0.3",
    "vite": "8.0.16",
    "vitest": "4.1.8"
  }
}
